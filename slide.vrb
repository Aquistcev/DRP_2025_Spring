\frametitle{Python Code Implementation}
\begin{lstlisting}[language=Python]
import numpy as np

def poly_mul(a, b):
    n, m = len(a), len(b)
    L = 1 << (n + m - 1).bit_length()
    A = np.fft.fft(a, L)
    B = np.fft.fft(b, L)
    C = A * B
    c = np.fft.ifft(C)
    c = np.rint(np.real(c)).astype(int)
    return c[:n+m-1]

    \end{lstlisting}
